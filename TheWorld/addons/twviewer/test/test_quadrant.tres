uniform sampler2D u_ground_normal_roughness_2;
uniform sampler2D u_ground_normal_roughness_3;
//uniform vec4 u_tile_reduction_per_texture = vec4(0.0, 0.0, 0.0, 0.0);	// Each component corresponds to a ground texture. Set greater than zero to enable.
//uniform float u_globalmap_blend_start = 0;		// 2000 ==> optimization: at 2000 WU from camera will be used global map instead of u_ground_albedo_bump_0/3 and u_ground_normal_roughness_0/3
//uniform float u_globalmap_blend_distance = 0;	// 1	==> 0 = disable use of global map
uniform vec4 u_colormap_opacity_per_texture = vec4(1.0, 1.0, 1.0, 1.0);	// NOTSET"
nodes/vertex/11/node = SubResource("VisualShaderNodeExpression_28flk")
nodes/vertex/11/position = Vector2(-1340, -360)
nodes/vertex/11/size = Vector2(620, 200)
nodes/vertex/11/input_ports = "0,4,vertex;"
nodes/vertex/11/output_ports = "0,5,vertex_world_pos;"
nodes/vertex/11/expression = "// VERTEX coords are local to the chunk (as the material is applied to the mesh which is tied to the chunk) so they start from the beginning of the chunk: we need to trasform in world coord to abstract from chunk
vertex_world_pos = MODEL_MATRIX * vec4(vertex, 1);"
nodes/vertex/12/node = SubResource("VisualShaderNodeExpression_51pd1")
nodes/vertex/12/position = Vector2(-240, -820)
nodes/vertex/12/size = Vector2(1020, 480)
nodes/vertex/12/input_ports = "0,5,vertex_world_pos;1,7,terrain_inverse_transform;2,8,terrain_heightmap;3,0,grid_step;4,2,optimization_level;"
nodes/vertex/12/output_ports = "0,3,vertex_cell_coords_in_textures;1,3,uv;"
nodes/vertex/12/expression = "// to calculate coords of the vertex local to the quadrant we use affine inverse matrix of the global trasform of the quadtree
vec4 vertex_local_to_quadrant_pos = terrain_inverse_transform * vertex_world_pos;
// to get correct value from the textures (in the range 0 / max size in local coord) we need to consider the step (dividing by it): in the textures heigths/normals are adjacent but in global/local coords are separated by the step
vertex_cell_coords_in_textures = vertex_local_to_quadrant_pos.xz / vec2(grid_step * pow(2.0, float(optimization_level)));
// Moreover must add a half-offset so that we sample the center of pixels, otherwise bilinear filtering of the textures will give us mixed results (#183)
vertex_cell_coords_in_textures += vec2(0.5);
// Normalized UV to be in the range 0/1
uv = vertex_cell_coords_in_textures / vec2(textureSize(terrain_heightmap, 0));"
