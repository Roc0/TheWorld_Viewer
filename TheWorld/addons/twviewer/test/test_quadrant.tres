nodes/fragment/4/input_ports = "0,0,distance_from_camera;1,4,vertex;2,5,ground_uv_scale_per_texture;3,2,piecing_threshold_factor;4,0,piece_size;5,0,scale_per_texture_factor;"
nodes/fragment/4/output_ports = "0,5,ground_uv_scale_per_texture_calc;"
nodes/fragment/4/expression = "ground_uv_scale_per_texture_calc = ground_uv_scale_per_texture;
if (distance_from_camera < (piece_size * float(piecing_threshold_factor)))
{
	vec3 fragment_world_pos = (INV_VIEW_MATRIX * vec4(vertex, 1.0)).xyz;
	int camera_piece_x = int(floor(CAMERA_POSITION_WORLD.x / piece_size));
	int camera_piece_y = int(floor(CAMERA_POSITION_WORLD.y / piece_size));
	int camera_piece_z = int(floor(CAMERA_POSITION_WORLD.z / piece_size));
	int frag_piece_x = int(floor(fragment_world_pos.x / piece_size));
	int frag_piece_y = int(floor(fragment_world_pos.y / piece_size));
	int frag_piece_z = int(floor(fragment_world_pos.z / piece_size));
	int pieces_from_camera_piece = max(int(abs(camera_piece_x - frag_piece_x)), int(abs(camera_piece_z - frag_piece_z)));
	pieces_from_camera_piece = max(pieces_from_camera_piece, int(abs(camera_piece_y - frag_piece_y)));
	if (pieces_from_camera_piece == 0)
	{
		ground_uv_scale_per_texture_calc /= (scale_per_texture_factor /* / pow(2.0, 0.0)*/);
	}
	if (pieces_from_camera_piece == 1)
	{
		ground_uv_scale_per_texture_calc /= (scale_per_texture_factor / 2.0 /* pow(2.0, 1.0)*/);
	}
	if (pieces_from_camera_piece == 2)
	{
		ground_uv_scale_per_texture_calc /= (scale_per_texture_factor / 4.0 /* pow(2.0, 2.0)*/);
	}
}"
