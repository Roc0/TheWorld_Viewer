[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform sampler2D u_terrain_normalmap;
uniform bool u_use_globalmap = false;
uniform sampler2D u_terrain_globalmap : source_color;
uniform vec4 u_ground_uv_scale_per_texture = vec4(20.000000, 20.000000, 20.000000, 20.000000);
uniform float u_piece_size = 300;
uniform float u_scale_per_texture_factor = 10;
uniform uint u_piecing_threshold_factor = 3;
uniform float u_globalmap_blend_start = 0;
uniform float u_globalmap_blend_distance = 0;
uniform float u_editmode_selected = 0;
uniform vec2 u_mouse_hit = vec2(-1.000000, -1.000000);
uniform float u_mouse_hit_radius = 0.0010000000475;
uniform bool u_triplanar = false;
uniform vec4 u_tile_reduction_per_texture = vec4(0.000000, 0.000000, 0.000000, 0.000000);
uniform bool u_depth_blending = false;

// Varyings
varying vec4 v_vertex_world_pos;
varying vec2 v_vertex_cell_coords_in_textures;
varying float v_distance_from_camera;
varying vec4 v_splat;
varying vec3 v_tint0;
varying vec3 v_tint1;
varying vec3 v_tint2;
varying vec3 v_tint3;

global uniform mat4 gu_terrain_inverse_transform;
uniform sampler2D u_terrain_heightmap;
global uniform float gu_grid_step = 2;
uniform uint u_optimization_level = 0;
uniform sampler2D u_terrain_splatmap;
uniform sampler2D u_terrain_colormap;


// GlobalExpression:0
	//vec3 model_world_space = MODEL_MATRIX[3].xyz; // Object's world space position. This is the equivalent to global_transform.origin in GDScript.
	//mat3 model_transform_basis = mat3(MODEL_MATRIX); // Object's world space transform basis. This is the equivalent to global_transform.basis in GDScript.
	//vec3 camera_world_space = INV_VIEW_MATRIX[3].xyz; // Camera's world space position. This is the equivalent to camera.global_transform.origin in GDScript.
	//vec3 camera_eye_world_space = VIEW_MATRIX[3].xyz; // Camera eye vector in world space direction of the camera.
	//vec3 camera_to_object_world_space = normalize(MODEL_MATRIX[3].xyz - INV_VIEW_MATRIX[3].xyz); // Camera's direction to the object in world space.
	
	uniform mat3 u_terrain_normal_basis;
	uniform float u_terrain_height = 1.0;	// NOTSET
	uniform float u_quad_border_line_thickness = 0.005;	// NOTSET
	uniform bool u_force_height_0 = false;
	uniform sampler2D u_ground_albedo_bump_0 : source_color;
	uniform sampler2D u_ground_albedo_bump_1 : source_color;
	uniform sampler2D u_ground_albedo_bump_2 : source_color;
	uniform sampler2D u_ground_albedo_bump_3 : source_color;
	uniform sampler2D u_ground_normal_roughness_0;
	uniform sampler2D u_ground_normal_roughness_1;
	uniform sampler2D u_ground_normal_roughness_2;
	uniform sampler2D u_ground_normal_roughness_3;
	//uniform vec4 u_tile_reduction_per_texture = vec4(0.0, 0.0, 0.0, 0.0);	// Each component corresponds to a ground texture. Set greater than zero to enable.
	//uniform float u_globalmap_blend_start = 0;		// 2000 ==> optimization: at 2000 WU from camera will be used global map instead of u_ground_albedo_bump_0/3 and u_ground_normal_roughness_0/3
	//uniform float u_globalmap_blend_distance = 0;	// 1	==> 0 = disable use of global map
	uniform vec4 u_colormap_opacity_per_texture = vec4(1.0, 1.0, 1.0, 1.0);	// NOTSET
// GlobalExpression:1
	float get_height(sampler2D tex, float terrain_height, vec2 uv)
	{
		return texture(tex, uv).r * terrain_height;
	}
// GlobalExpression:2
	vec4 pack_normal(vec3 n, float a) {
		//n.z *= -1.0;
		return vec4((n.xzy + vec3(1.0)) * 0.5, a);
	}
	
	vec3 unpack_normal(vec4 rgba) {
		// If we consider texture space starts from top-left corner and Y goes down,
		// then Y+ in pixel space corresponds to Z+ in terrain space,
		// while X+ also corresponds to X+ in terrain space.
		vec3 n = rgba.xzy * 2.0 - vec3(1.0);
		// Had to negate Z because it comes from Y in the normal map,
		// and OpenGL-style normal maps are Y-up.
		//n.z *= -1.0;
		return n;
	}
// GlobalExpression:3
	vec3 get_normal(sampler2D tex, mat3 terrain_normal_basis, vec2 uv){
		// Need to use terrain_normal_basis to handle scaling.
		vec3 n = terrain_normal_basis * unpack_normal(texture(tex, uv));
		//vec3 n = unpack_normal(texture(tex, uv));
		return normalize(n);
	}
// GlobalExpression:4
	bool is_on_the_border(vec2 uv, float line_thickness){
		//float line_thickness = 0.01;
		if (uv.x > line_thickness && uv.x < (1.0 - line_thickness) && uv.y > line_thickness && uv.y < (1.0 - line_thickness)) {
			return false;
		} else {
			return true;
		}
	}
// GlobalExpression:5
	vec3 get_triplanar_blend(vec3 world_normal) {
		vec3 blending = abs(world_normal);
		blending = normalize(max(blending, vec3(0.00001))); // Force weights to sum to 1.0
		float b = blending.x + blending.y + blending.z;
		return blending / vec3(b, b, b);
	}
// GlobalExpression:6
	vec4 texture_triplanar(sampler2D tex, vec3 world_pos, vec3 blend) {
		vec4 xaxis = texture(tex, world_pos.yz);
		vec4 yaxis = texture(tex, world_pos.xz);
		vec4 zaxis = texture(tex, world_pos.xy);
		// blend the results of the 3 planar projections.
		return xaxis * blend.x + yaxis * blend.y + zaxis * blend.z;
	}
// GlobalExpression:7
	vec4 depth_blend2(vec4 a_value, float a_bump, vec4 b_value, float b_bump, float t) {
		// https://www.gamasutra.com
		// /blogs/AndreyMishkinis/20130716/196339/Advanced_Terrain_Texture_Splatting.php
		float d = 0.1;
		float ma = max(a_bump + (1.0 - t), b_bump + t) - d;
		float ba = max(a_bump + (1.0 - t) - ma, 0.0);
		float bb = max(b_bump + t - ma, 0.0);
		return (a_value * ba + b_value * bb) / (ba + bb);
	}
	
	vec2 rotate(vec2 v, float cosa, float sina) {
		return vec2(cosa * v.x - sina * v.y, sina * v.x + cosa * v.y);
	}
	
	vec4 texture_antitile(sampler2D albedo_tex, sampler2D normal_tex, vec2 uv, out vec4 out_normal) {
		float frequency = 2.0;
		float scale = 1.3;
		float sharpness = 0.7;
		
		// Rotate and scale UV
		float rot = 3.14 * 0.6;
		float cosa = cos(rot);
		float sina = sin(rot);
		vec2 uv2 = rotate(uv, cosa, sina) * scale;
		
		vec4 col0 = texture(albedo_tex, uv);
		vec4 col1 = texture(albedo_tex, uv2);
		vec4 nrm0 = texture(normal_tex, uv);
		vec4 nrm1 = texture(normal_tex, uv2);
		//col0 = vec4(0.0, 0.5, 0.5, 1.0); // Highlights variations
	
		// Normals have to be rotated too since we are rotating the texture...
		// TODO Probably not the most efficient but understandable for now
		vec3 n = unpack_normal(nrm1);
		// Had to negate the Y axis for some reason. I never remember the myriad of conventions around
		n.xz = rotate(n.xz, cosa, -sina);
		nrm1 = pack_normal(n, nrm1.a);
		
		// Periodically alternate between the two versions using a warped checker pattern
		float t = 1.2 + 
			  sin(uv2.x * frequency + sin(uv.x) * 2.0) 
			* cos(uv2.y * frequency + sin(uv.y) * 2.0); // Result in [0..2]
		t = smoothstep(sharpness, 2.0 - sharpness, t);
	
		// Using depth blend because classic alpha blending smoothes out details.
		out_normal = depth_blend2(nrm0, col0.a, nrm1, col1.a, t);
		return depth_blend2(col0, col0.a, col1, col1.a, t);
	}
// GlobalExpression:8
	vec4 get_depth_blended_weights(vec4 splat, vec4 bumps) {
		float dh = 0.2;
	
		vec4 h = bumps + splat;
	
		// TODO Keep improving multilayer blending, there are still some edge cases...
		// Mitigation: nullify layers with near-zero splat
		h *= smoothstep(0, 0.05, splat);
	
		vec4 d = h + dh;
		d.r -= max(h.g, max(h.b, h.a));
		d.g -= max(h.r, max(h.b, h.a));
		d.b -= max(h.g, max(h.r, h.a));
		d.a -= max(h.g, max(h.b, h.r));
	
		return clamp(d, 0, 1);
	}

void vertex() {
// Input:15
	vec3 n_out15p0 = VERTEX;


	vec4 n_out11p0;
// Expression:11
	n_out11p0 = vec4(0.0, 0.0, 0.0, 0.0);
	{
		// VERTEX coords are local to the chunk (as the material is applied to the mesh which is tied to the chunk) so they start from the beginning of the chunk: we need to trasform in world coord to abstract from chunk
		n_out11p0 = MODEL_MATRIX * vec4(n_out15p0, 1);
	}


// TransformParameter:35
	mat4 n_out35p0 = gu_terrain_inverse_transform;


// FloatParameter:37
	float n_out37p0 = gu_grid_step;


// UIntParameter:36
	uint n_out36p0 = u_optimization_level;


	vec2 n_out12p0;
	vec2 n_out12p1;
// Expression:12
	n_out12p0 = vec2(0.0, 0.0);
	n_out12p1 = vec2(0.0, 0.0);
	{
		// to calculate coords of the vertex local to the quadrant we use affine inverse matrix of the global trasform of the quadtree
		vec4 vertex_local_to_quadrant_pos = n_out35p0 * n_out11p0;
		// to get correct value from the textures (in the range 0 / max size in local coord) we need to consider the step (dividing by it): in the textures heigths/normals are adjacent but in global/local coords are separated by the step
		n_out12p0 = vertex_local_to_quadrant_pos.xz / vec2(n_out37p0 * pow(2.0, float(n_out36p0)));
		// Moreover must add a half-offset so that we sample the center of pixels, otherwise bilinear filtering of the textures will give us mixed results (#183)
		n_out12p0 += vec2(0.5);
		// Normalized UV to be in the range 0/1
		n_out12p1 = n_out12p0 / vec2(textureSize(u_terrain_heightmap, 0));
	}


	vec3 n_out13p0;
	vec4 n_out13p1;
// Expression:13
	n_out13p0 = vec3(0.0, 0.0, 0.0);
	n_out13p1 = vec4(0.0, 0.0, 0.0, 0.0);
	{
		n_out13p0 = n_out15p0;
		float h = get_height(u_terrain_heightmap, u_terrain_height, n_out12p1);		// Height displacement from heigthmap
		if (u_force_height_0) {													// Needed to bake globalmap
			n_out13p0.y = 0.0;
			n_out11p0.y = 0.0;
		} else {
			n_out13p0.y = h;
			n_out11p0.y = h;
		}
	}


	vec3 n_out20p0;
// Expression:20
	n_out20p0 = vec3(0.0, 0.0, 0.0);
	{
		vec3 n_out20p0 = get_normal(u_terrain_normalmap, u_terrain_normal_basis, n_out12p1);
	}


// Output:0
	VERTEX = n_out13p0;
	NORMAL = n_out20p0;
	UV = n_out12p1;


// VaryingSetter:14
	v_vertex_world_pos = n_out13p1;


// VaryingSetter:16
	v_vertex_cell_coords_in_textures = n_out12p0;


	float n_out18p0;
// Expression:18
	n_out18p0 = 0.0;
	{
		n_out18p0 = distance(n_out13p1.xyz, INV_VIEW_MATRIX[3].xyz);
	}


// VaryingSetter:19
	v_distance_from_camera = n_out18p0;


// BooleanParameter:38
	bool n_out38p0 = u_use_globalmap;


	vec4 n_out23p0;
// Expression:23
	n_out23p0 = vec4(0.0, 0.0, 0.0, 0.0);
	{
		if (!n_out38p0) {
				vec4 n_out23p0 = texture(u_terrain_splatmap, n_out12p1);
		}
	}


// VaryingSetter:24
	v_splat = n_out23p0;


	vec3 n_out25p0;
	vec3 n_out25p1;
	vec3 n_out25p2;
	vec3 n_out25p3;
// Expression:25
	n_out25p0 = vec3(0.0, 0.0, 0.0);
	n_out25p1 = vec3(0.0, 0.0, 0.0);
	n_out25p2 = vec3(0.0, 0.0, 0.0);
	n_out25p3 = vec3(0.0, 0.0, 0.0);
	{
		vec4 tint = texture(u_terrain_colormap, n_out12p1);
		vec3 n_out25p0 = mix(vec3(1.0), tint.rgb, u_colormap_opacity_per_texture.x);	// decreasing u_colormap_opacity_per_texture dimensions approximates vector tint (u_terrain_colormap texel) to white: each dimnesion (1-4) acts
		vec3 n_out25p1 = mix(vec3(1.0), tint.rgb, u_colormap_opacity_per_texture.y);	// on the corresponding bump_map (1-4). More precisely u_colormap_opacity_per_texture.(x-w) must be in the interval 0-1, if 0 the function returns 
		vec3 n_out25p2 = mix(vec3(1.0), tint.rgb, u_colormap_opacity_per_texture.z);	// vec3(1.0) if 1 (default value) the function returns tint.rgb
		vec3 n_out25p3 = mix(vec3(1.0), tint.rgb, u_colormap_opacity_per_texture.w);
	}


// VaryingSetter:26
	v_tint0 = n_out25p0;


// VaryingSetter:27
	v_tint1 = n_out25p1;


// VaryingSetter:28
	v_tint2 = n_out25p2;


// VaryingSetter:29
	v_tint3 = n_out25p3;


}

void fragment() {
// VaryingGetter:3
	float n_out3p0 = v_distance_from_camera;


// ParameterRef:23
	float n_out23p0 = u_globalmap_blend_start;


// ParameterRef:24
	float n_out24p0 = u_globalmap_blend_distance;


// Input:13
	vec2 n_out13p0 = UV;


// ParameterRef:26
	float n_out26p0 = u_editmode_selected;


// ParameterRef:21
	bool n_out21p0 = u_use_globalmap;


	bool n_out25p0;
	bool n_out25p1;
// Expression:25
	n_out25p0 = false;
	n_out25p1 = false;
	{
		if (n_out26p0 > 0.0 && is_on_the_border(n_out13p0, u_quad_border_line_thickness)) {
			n_out25p0 = true;
		} else {
			n_out25p0 = false;
		}
		if (n_out21p0) {
			n_out25p1 = true;
		} else {
			n_out25p1 = false;
		}
	}


	vec3 n_out33p0;
	float n_out33p1;
	float n_out33p2;
// Expression:33
	n_out33p0 = vec3(0.0, 0.0, 0.0);
	n_out33p1 = 0.0;
	n_out33p2 = 0.0;
	{
		n_out33p2 = 1.0;
		n_out33p1 = 1.0;
		if (n_out25p0) {
			n_out33p0 = vec3(1.0, 0.749, 0.0);		// GDN_TheWorld_Globals::g_color_yellow_apricot
		} else {
			n_out33p0 = texture(u_terrain_globalmap, n_out13p0).rgb;
			if (n_out25p1) {
				n_out33p1 = 0.5;
			} else {
				n_out33p2 = clamp((n_out3p0 - n_out23p0) * n_out24p0, 0.0, 1.0);
				n_out33p2 *= n_out33p2; // slower start, faster transition but far away
			}
		}
	}


// ParameterRef:34
	bool n_out34p0 = u_triplanar;


	vec3 n_out14p0;
	vec3 n_out14p1;
// Expression:14
	n_out14p0 = vec3(0.0, 0.0, 0.0);
	n_out14p1 = vec3(0.0, 0.0, 0.0);
	{
		n_out14p0 = get_normal(u_terrain_normalmap, u_terrain_normal_basis, n_out13p0);
		n_out14p1 = n_out14p0;
	}


// VaryingGetter:11
	vec2 n_out11p0 = v_vertex_cell_coords_in_textures;


// VaryingGetter:12
	vec4 n_out12p0 = v_vertex_world_pos;


// Input:8
	vec3 n_out8p0 = VERTEX;


// ParameterRef:17
	vec4 n_out17p0 = u_ground_uv_scale_per_texture;


// ParameterRef:18
	uint n_out18p0 = u_piecing_threshold_factor;


// ParameterRef:19
	float n_out19p0 = u_piece_size;


// ParameterRef:20
	float n_out20p0 = u_scale_per_texture_factor;


	vec4 n_out4p0;
// Expression:4
	n_out4p0 = vec4(0.0, 0.0, 0.0, 0.0);
	{
		n_out4p0 = n_out17p0;
		if (n_out3p0 < (n_out19p0 * float(n_out18p0)))
		{
			vec3 fragment_world_pos = (INV_VIEW_MATRIX * vec4(n_out8p0, 1.0)).xyz;
			int camera_piece_x = int(floor(CAMERA_POSITION_WORLD.x / n_out19p0));
			int camera_piece_y = int(floor(CAMERA_POSITION_WORLD.y / n_out19p0));
			int camera_piece_z = int(floor(CAMERA_POSITION_WORLD.z / n_out19p0));
			int frag_piece_x = int(floor(fragment_world_pos.x / n_out19p0));
			int frag_piece_y = int(floor(fragment_world_pos.y / n_out19p0));
			int frag_piece_z = int(floor(fragment_world_pos.z / n_out19p0));
			int pieces_from_camera_piece = max(int(abs(camera_piece_x - frag_piece_x)), int(abs(camera_piece_z - frag_piece_z)));
			pieces_from_camera_piece = max(pieces_from_camera_piece, int(abs(camera_piece_y - frag_piece_y)));
			if (pieces_from_camera_piece == 0)
			{
				n_out4p0 /= (n_out20p0 /* / pow(2.0, 0.0)*/);
			}
			if (pieces_from_camera_piece == 1)
			{
				n_out4p0 /= (n_out20p0 / 2.0 /* pow(2.0, 1.0)*/);
			}
			if (pieces_from_camera_piece == 2)
			{
				n_out4p0 /= (n_out20p0 / 4.0 /* pow(2.0, 2.0)*/);
			}
		}
	}


	vec2 n_out10p0;
	vec2 n_out10p1;
	vec2 n_out10p2;
	vec3 n_out10p3;
// Expression:10
	n_out10p0 = vec2(0.0, 0.0);
	n_out10p1 = vec2(0.0, 0.0);
	n_out10p2 = vec2(0.0, 0.0);
	n_out10p3 = vec3(0.0, 0.0, 0.0);
	{
		vec3 base_ground_uv = vec3(n_out11p0.x, n_out12p0.y * MODEL_MATRIX[1][1], n_out11p0.y);
		n_out10p0 = base_ground_uv.xz / n_out4p0.x;		// 2-dimension vertex ccordinates in vertex textures (height, normal, splat, color, global) divided by a scale factor
		n_out10p1 = base_ground_uv.xz / n_out4p0.y;		// these coordinates are used to fetch u_ground_albedo_bump_0 and u_ground_normal_roughness_0 
		n_out10p2 = base_ground_uv.xz / n_out4p0.z;
		n_out10p3 = base_ground_uv / n_out4p0.w;		// 3-dimension vertex ccordinates in vertex textures (height, normal, splat, color, global) divided by a scale factor (y coord is height in world coord)
	}


// ParameterRef:35
	vec4 n_out35p0 = u_tile_reduction_per_texture;


// VaryingGetter:38
	vec3 n_out38p0 = v_tint0;


// VaryingGetter:39
	vec3 n_out39p0 = v_tint1;


// VaryingGetter:40
	vec3 n_out40p0 = v_tint2;


// VaryingGetter:41
	vec3 n_out41p0 = v_tint3;


// VaryingGetter:37
	vec4 n_out37p0 = v_splat;


// ParameterRef:36
	bool n_out36p0 = u_depth_blending;


	vec3 n_out30p0;
	float n_out30p1;
	vec3 n_out30p2;
// Expression:30
	n_out30p0 = vec3(0.0, 0.0, 0.0);
	n_out30p1 = 0.0;
	n_out30p2 = vec3(0.0, 0.0, 0.0);
	{
		if (n_out25p0 || n_out25p1) {
			n_out30p1 = n_out33p1;
			n_out30p0 = n_out33p0;
			n_out30p2 = n_out14p0;
		} else {
			vec4 ab0, ab1, ab2, ab3;
			vec4 nr0, nr1, nr2, nr3;
		
			if (n_out34p0) {
				// Only do n_out34p0 on one texture slot,
				// because otherwise it would be very expensive and cost many more ifs.
				// I chose the last slot because first slot is the default on new splatmaps,
				// and that's a feature used for cliffs, which are usually designed later.
		
				vec3 blending = get_triplanar_blend(n_out14p0);
		
				ab3 = texture_triplanar(u_ground_albedo_bump_3, n_out10p3, blending);
				nr3 = texture_triplanar(u_ground_normal_roughness_3, n_out10p3, blending);
		
			} else {
				if (n_out35p0[3] > 0.0) {
					ab3 = texture_antitile(u_ground_albedo_bump_3, u_ground_normal_roughness_3, n_out10p3.xz, nr3);
				} else {
					ab3 = texture(u_ground_albedo_bump_3, n_out10p3.xz);
					nr3 = texture(u_ground_normal_roughness_3, n_out10p3.xz);
				}
			}
		
			if (n_out35p0[0] > 0.0) {
				ab0 = texture_antitile(u_ground_albedo_bump_0, u_ground_normal_roughness_0, n_out10p0, nr0);
			} else {
				ab0 = texture(u_ground_albedo_bump_0, n_out10p0);
				nr0 = texture(u_ground_normal_roughness_0, n_out10p0);
			}
			if (n_out35p0[1] > 0.0) {
				ab1 = texture_antitile(u_ground_albedo_bump_1, u_ground_normal_roughness_1, n_out10p1, nr1);
			} else {
				ab1 = texture(u_ground_albedo_bump_1, n_out10p1);
				nr1 = texture(u_ground_normal_roughness_1, n_out10p1);
			}
			if (n_out35p0[2] > 0.0) {
				ab2 = texture_antitile(u_ground_albedo_bump_2, u_ground_normal_roughness_2, n_out10p2, nr2);
			} else {
				ab2 = texture(u_ground_albedo_bump_2, n_out10p2);
				nr2 = texture(u_ground_normal_roughness_2, n_out10p2);
			}
		
			vec3 col0 = ab0.rgb * n_out38p0;	// col(0-3) is the result of the pixel fetched from u_ground_albedo_bump_(0-3) modified by the value fetched from u_terrain_colormap and relative to the vertex corresponding to current pixel
			vec3 col1 = ab1.rgb * n_out39p0;	// the value fetched from u_terrain_colormap if modified to the white according to the vector u_colormap_opacity_per_texture (default value don't modify the color)
			vec3 col2 = ab2.rgb * n_out40p0;
			vec3 col3 = ab3.rgb * n_out41p0;
		
			vec4 rough = vec4(nr0.a, nr1.a, nr2.a, nr3.a);
		
			//vec3 normal0 = unpack_normal(nr0);
			//vec3 normal1 = unpack_normal(nr1);
			//vec3 normal2 = unpack_normal(nr2);
			//vec3 normal3 = unpack_normal(nr3);
			vec3 normal0 = nr0.rgb;
			vec3 normal1 = nr1.rgb;
			vec3 normal2 = nr2.rgb;
			vec3 normal3 = nr3.rgb;
		
			vec4 w;
			// TODO An #ifdef macro would be nice! Or copy/paste everything in a different shader...
			if (n_out36p0) {
				w = get_depth_blended_weights(n_out37p0, vec4(ab0.a, ab1.a, ab2.a, ab3.a));
			} else {
				w = n_out37p0.rgba;
			}
		
			float w_sum = (w.r + w.g + w.b + w.a);
		
			n_out30p0 = (
				w.r * col0.rgb +
				w.g * col1.rgb +
				w.b * col2.rgb +
				w.a * col3.rgb) / w_sum;
		
			n_out30p1 = (
				w.r * rough.r +
				w.g * rough.g +
				w.b * rough.b +
				w.a * rough.a) / w_sum;
		
			vec3 ground_normal = /*u_terrain_normal_basis **/ (
				w.r * normal0 +
				w.g * normal1 +
				w.b * normal2 +
				w.a * normal3) / w_sum;
			// If no n_out37p0 textures are defined, normal vectors will default to (1,1,1),
			// which is incorrect, and causes the terrain to be shaded wrongly in some directions.
			// However, this should not be a problem to fix in the shader,
			// because there MUST be at least one n_out37p0 texture set.
			//ground_normal = normalize(ground_normal);
			// TODO Make the plugin insert a default normalmap if it's empty
		
			// Combine terrain normals with detail normals (not sure if correct but looks ok)
			n_out30p2 = normalize(vec3(n_out14p0.x + ground_normal.x, n_out14p0.y, n_out14p0.z + ground_normal.z));
			n_out30p2 = mix(n_out30p2, n_out14p0, n_out33p2);
		
			n_out30p0 = mix(n_out30p0, n_out33p0, n_out33p2);
		
			n_out30p1 = mix(n_out30p1, 1.0, n_out33p2);
		}
	}


// ParameterRef:27
	vec2 n_out27p0 = u_mouse_hit;


// ParameterRef:28
	float n_out28p0 = u_mouse_hit_radius;


	vec3 n_out31p0;
	vec3 n_out31p1;
	float n_out31p2;
// Expression:31
	n_out31p0 = vec3(0.0, 0.0, 0.0);
	n_out31p1 = vec3(0.0, 0.0, 0.0);
	n_out31p2 = 0.0;
	{
		if (n_out27p0 != vec2(-1) && n_out28p0 != 0.0 && distance(n_out27p0, UV) < n_out28p0) {
			vec3 mouse_hit_albedo = vec3(1.0, 0.749, 0.0);		// GDN_TheWorld_Globals::g_color_yellow_apricot
			n_out31p0 = mix(n_out30p0, mouse_hit_albedo, 0.3);
		}
		n_out31p1 = (VIEW_MATRIX * (vec4(n_out30p2, 0.0))).xyz;
		n_out31p2 = n_out30p1;
	}


// Output:0
	ALBEDO = n_out31p0;
	ROUGHNESS = n_out31p2;
	NORMAL = n_out31p1;


}
"
