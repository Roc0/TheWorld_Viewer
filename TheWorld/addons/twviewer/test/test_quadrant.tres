[sub_resource type="VisualShaderNodeGlobalExpression" id="VisualShaderNodeGlobalExpression_kpbi3"]
size = Vector2(1020, 260)
expression = "bool is_on_the_border(vec2 uv, float line_thickness){
	//float line_thickness = 0.01;
	if (uv.x > line_thickness && uv.x < (1.0 - line_thickness) && uv.y > line_thickness && uv.y < (1.0 - line_thickness)) {
		return false;
	} else {
		return true;
	}
}"

