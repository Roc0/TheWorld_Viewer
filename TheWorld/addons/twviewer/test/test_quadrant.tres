[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_anper"]
size = Vector2(620, 380)
expression = "vec4 tint = texture(terrain_colormap, uv);
vec3 tint0 = mix(vec3(1.0), tint.rgb, u_colormap_opacity_per_texture.x);	// decreasing u_colormap_opacity_per_texture dimensions approximates vector tint (u_terrain_colormap texel) to white: each dimnesion (1-4) acts
vec3 tint1 = mix(vec3(1.0), tint.rgb, u_colormap_opacity_per_texture.y);	// on the corresponding bump_map (1-4). More precisely u_colormap_opacity_per_texture.(x-w) must be in the interval 0-1, if 0 the function returns 
vec3 tint2 = mix(vec3(1.0), tint.rgb, u_colormap_opacity_per_texture.z);	// vec3(1.0) if 1 (default value) the function returns tint.rgb
vec3 tint3 = mix(vec3(1.0), tint.rgb, u_colormap_opacity_per_texture.w);"

