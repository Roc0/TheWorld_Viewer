[gd_resource type="VisualShader" load_steps=79 format=3 uid="uid://cux0qnf6ydgr2"]

[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_elcve"]
size = Vector2(900, 380)
expression = "vec3 base_ground_uv = vec3(vertex_cell_coords_in_textures.x, vertex_world_pos.y * MODEL_MATRIX[1][1], vertex_cell_coords_in_textures.y);
ground_uv0 = base_ground_uv.xz / ground_uv_scale_per_texture.x;		// 2-dimension vertex ccordinates in vertex textures (height, normal, splat, color, global) divided by a scale factor
ground_uv1 = base_ground_uv.xz / ground_uv_scale_per_texture.y;		// these coordinates are used to fetch u_ground_albedo_bump_0 and u_ground_normal_roughness_0 
ground_uv2 = base_ground_uv.xz / ground_uv_scale_per_texture.z;
ground_uv3 = base_ground_uv / ground_uv_scale_per_texture.w;		// 3-dimension vertex ccordinates in vertex textures (height, normal, splat, color, global) divided by a scale factor (y coord is height in world coord)"

