nodes/fragment/connections = PackedInt32Array(3, 0, 4, 0, 8, 0, 4, 1, 4, 0, 10, 2, 12, 0, 10, 1, 11, 0, 10, 0, 13, 0, 14, 0, 16, 0, 14, 1, 17, 0, 4, 2, 18, 0, 4, 3, 19, 0, 4, 4, 20, 0, 4, 5, 26, 0, 25, 0, 31, 0, 0, 0, 13, 0, 25, 1, 21, 0, 25, 2, 29, 0, 33, 3, 13, 0, 33, 4, 24, 0, 33, 2, 23, 0, 33, 1, 3, 0, 33, 0, 25, 0, 33, 5, 25, 1, 33, 6, 27, 0, 31, 1, 28, 0, 31, 2, 31, 1, 0, 8, 31, 2, 0, 3, 10, 0, 30, 7, 10, 1, 30, 8, 10, 2, 30, 9, 10, 3, 30, 10, 33, 0, 30, 0, 30, 0, 31, 0, 14, 0, 30, 4, 30, 2, 31, 3, 33, 1, 30, 1, 30, 1, 31, 4, 33, 2, 30, 2, 34, 0, 30, 3, 25, 0, 30, 5, 25, 1, 30, 6, 35, 0, 30, 11, 36, 0, 30, 17, 37, 0, 30, 16, 41, 0, 30, 15, 40, 0, 30, 14, 39, 0, 30, 13, 38, 0, 30, 12)
