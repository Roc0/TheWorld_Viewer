if (mouse_hit != vec2(-1)) {
	float half_texel_size = 0.5 / vec2(textureSize(u_terrain_heightmap, 0)).x;
	vec2 uv_begin_texel = uv - vec2(half_texel_size);
	vec2 distance_from_vertex = 
		fract(vec2(uv_begin_texel.x / (half_texel_size * 2.0), uv_begin_texel.y / (half_texel_size * 2.0)));
	float grid_radius = mouse_hit_radius * 5.0;
	if (grid_radius != 0.0 && distance(mouse_hit, uv) < grid_radius)
	{
		if (distance_from_vertex.x < quad_line_thickness || (1.0 - distance_from_vertex.x) < quad_line_thickness
			|| distance_from_vertex.y < quad_line_thickness || (1.0 - distance_from_vertex.y) < quad_line_thickness) {
			if ((distance_from_vertex.x < quad_line_thickness || (1.0 - distance_from_vertex.x) < quad_line_thickness)
				&& (distance_from_vertex.y < quad_line_thickness || (1.0 - distance_from_vertex.y) < quad_line_thickness)) {
				//albedo_out = mix(albedo_out, vec3(1.0, 0.0, 0.0), 0.3);	// GDN_TheWorld_Globals::g_color_yellow_red
				albedo_out = vec3(1.0, 0.0, 0.0);	// GDN_TheWorld_Globals::g_color_yellow_red
			} else {
				//albedo_out = mix(albedo_out, vec3(1.0, 0.749, 0.0), 0.3);	// GDN_TheWorld_Globals::g_color_yellow_apricot
				albedo_out = vec3(1.0, 0.749, 0.0);	// GDN_TheWorld_Globals::g_color_yellow_apricot
			}
		}
	}

	if (mouse_hit_radius != 0.0 && distance(mouse_hit, uv) < mouse_hit_radius) {
		vec3 mouse_hit_albedo = vec3(1.0, 0.749, 0.0);		// GDN_TheWorld_Globals::g_color_yellow_apricot
		albedo_out = mix(albedo_out, mouse_hit_albedo, 0.3);
	}
}"
