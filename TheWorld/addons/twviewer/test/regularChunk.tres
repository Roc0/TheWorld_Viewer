nodes/fragment/56/node = SubResource("VisualShaderNodeExpression_bq5dl")
nodes/fragment/56/position = Vector2(4620, 200)
nodes/fragment/56/size = Vector2(960, 2860)
nodes/fragment/56/input_ports = "0,4,albedo_in;1,0,roughness_in;2,0,globalmap_factor;3,4,normal_in;4,6,editmode_pixel;5,6,globalmap_pixel;6,4,tint0;7,4,tint1;8,4,tint2;9,4,tint3;10,5,splat;11,6,depth_blending;12,5,ab0;13,5,ab1;14,5,ab2;15,5,ab3;16,5,nr0;17,5,nr1;18,5,nr2;19,5,nr3;"
nodes/fragment/56/output_ports = "0,4,albedo_out;1,0,roughness_out;2,4,normal_out;3,0,ao_out;4,0,ao_light_affect_out;"
nodes/fragment/56/expression = "if (editmode_pixel || globalmap_pixel) {
	roughness_out = roughness_in;
	albedo_out = albedo_in;
	normal_out = normal_in;
} else {
	// col(0-3) is the result of the pixel fetched from u_ground_albedo_bump_(0-3) modified
	// by the value fetched from u_terrain_colormap and relative to the vertex corresponding
	// to current pixel
	// the value fetched from u_terrain_colormap if modified to the white according to the
	// vector u_colormap_opacity_per_texture (default value don't modify the color)
	vec3 col0 = ab0.rgb * tint0;	
	vec3 col1 = ab1.rgb * tint1;	
	vec3 col2 = ab2.rgb * tint2;
	vec3 col3 = ab3.rgb * tint3;
	//col0 = ab0.rgb;
	//col1 = ab1.rgb;
	//col2 = ab2.rgb;
	//col3 = ab3.rgb;

	vec4 rough = vec4(nr0.a, nr1.a, nr2.a, nr3.a);

	//vec3 normal0 = unpack_normal(nr0);
	//vec3 normal1 = unpack_normal(nr1);
	//vec3 normal2 = unpack_normal(nr2);
	//vec3 normal3 = unpack_normal(nr3);
	vec3 normal0 = nr0.rgb;
	vec3 normal1 = nr1.rgb;
	vec3 normal2 = nr2.rgb;
	vec3 normal3 = nr3.rgb;

	vec4 w;
	// TODO An #ifdef macro would be nice! Or copy/paste everything in a different shader...
	if (depth_blending) {
		w = get_depth_blended_weights(splat, vec4(ab0.a, ab1.a, ab2.a, ab3.a));
	} else {
		w = splat.rgba;
	}

	float w_sum = (w.r + w.g + w.b + w.a);

	albedo_out = (
		w.r * col0.rgb +
		w.g * col1.rgb +
		w.b * col2.rgb +
		w.a * col3.rgb) / w_sum;

	roughness_out = (
		w.r * rough.r +
		w.g * rough.g +
		w.b * rough.b +
		w.a * rough.a) / w_sum;

	vec3 ground_normal = /*u_terrain_normal_basis **/ (
		w.r * normal0 +
		w.g * normal1 +
		w.b * normal2 +
		w.a * normal3) / w_sum;
	// If no splat textures are defined, normal vectors will default to (1,1,1),
	// which is incorrect, and causes the terrain to be shaded wrongly in some directions.
	// However, this should not be a problem to fix in the shader,
	// because there MUST be at least one splat texture set.
	//ground_normal = normalize(ground_normal);
	// TODO Make the plugin insert a default normalmap if it's empty

	// Combine terrain normals with detail normals (not sure if correct but looks ok)
	normal_out = normalize(vec3(normal_in.x + ground_normal.x, normal_in.y, normal_in.z + ground_normal.z));
	normal_out = mix(normal_out, normal_in, globalmap_factor);
	albedo_out = mix(albedo_out, albedo_in, globalmap_factor);
	roughness_out = mix(roughness_out, 1.0, globalmap_factor);
	ao_out = (w.r * ab0.a +	w.g * ab1.a + w.b * ab2.a +	w.a * ab3.a) / w_sum;
	ao_light_affect_out = 0.1;
	//METALLIC = (w.r * ab0.a +	w.g * ab1.a + w.b * ab2.a +	w.a * ab3.a) / w_sum;
	//SPECULAR = 0.5;
	
	/*vec3 red = vec3(1.0, 0.0, 0.0);
	vec3 green = vec3(0.0, 1.0, 0.0);
	vec3 blue = vec3(0.0, 0.0, 1.0);
	vec3 yellow = vec3(1.0, 0.749, 0.0);
	if (splat.x < 0.0)	{
		albedo_out = red;
	}
	if (splat.y < 0.0)	{
		albedo_out = green;
	}
	if (splat.z < 0.0)	{
		albedo_out = blue;
	}
	if (splat.a < 0.0)	{
		albedo_out = yellow;
	}*/
}"
