[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_2wp3x"]
size = Vector2(760, 3480)
expression = "roughness_out = roughness_in;
albedo_out = albedo_in;
normal_out = normal_in;
ab0_out = ab0_in;
ab1_out = ab1_in;
ab2_out = ab2_in;
ab3_out = ab3_in;
nr0_out = nr0_in;
nr1_out = nr1_in;
nr2_out = nr2_in;
nr3_out = nr3_in;

if (!editmode_pixel && !globalmap_pixel) {
	if (is_on_upper_border(uv, distance_from_border)) {
		if (u_north_ground_layers.x >= 0.0) {
			vec4 ab0_north = texture_albedo_bump(0, u_north_ground_layers.x, uv);
			ab0_out = mix(ab0_out, ab0_north, weight);
			vec4 nr0_north = texture_normal_roughness(0, u_north_ground_layers.x, uv);
			nr0_out = mix(nr0_out, nr0_north, weight);
			//ab0_out = texture_albedo_bump(0, u_north_ground_layers.x, uv);
			//nr0_out = texture_normal_roughness(0, u_north_ground_layers.x, uv);
		}
		if (u_north_ground_layers.y >= 0.0) {
			vec4 ab1_north = texture_albedo_bump(1, u_north_ground_layers.y, uv);
			ab1_out = mix(ab1_out, ab1_north, weight);
			vec4 nr1_north = texture_normal_roughness(1, u_north_ground_layers.y, uv);
			nr1_out = mix(nr1_out, nr1_north, weight);
			//ab1_out = texture_albedo_bump(1, u_north_ground_layers.y, uv);
			//nr1_out = texture_normal_roughness(1, u_north_ground_layers.y, uv);
		}
		if (u_north_ground_layers.z >= 0.0) {
			vec4 ab2_north = texture_albedo_bump(2, u_north_ground_layers.z, uv);
			ab2_out = mix(ab2_out, ab2_north, weight);
			vec4 nr2_north = texture_normal_roughness(2, u_north_ground_layers.z, uv);
			nr2_out = mix(nr2_out, nr2_north, weight);
			//ab2_out = texture_albedo_bump(2, u_north_ground_layers.z, uv);
			//nr2_out = texture_normal_roughness(2, u_north_ground_layers.z, uv);
		}
		if (u_north_ground_layers.a >= 0.0) {
			vec4 ab3_north = texture_albedo_bump(3, u_north_ground_layers.a, uv);
			ab3_out = mix(ab3_out, ab3_north, weight);
			vec4 nr3_north = texture_normal_roughness(3, u_north_ground_layers.a, uv);
			nr3_out = mix(nr3_out, nr3_north, weight);
			//ab3_out = texture_albedo_bump(3, u_north_ground_layers.a, uv);
			//nr3_out = texture_normal_roughness(3, u_north_ground_layers.a, uv);
		}
		//ab0_out = vec4(0.0, 1.0, 0.0, 1.0);
		//ab1_out = vec4(1.0, 0.0, 0.0, 1.0);
	}
	if (is_on_lower_border(uv, distance_from_border)) {
		if (u_south_ground_layers.x >= 0.0) {
			vec4 ab0_south = texture_albedo_bump(0, u_south_ground_layers.x, uv);
			ab0_out = mix(ab0_out, ab0_south, weight);
			vec4 nr0_south = texture_normal_roughness(0, u_south_ground_layers.x, uv);
			nr0_out = mix(nr0_out, nr0_south, weight);
			//ab0_out = texture_albedo_bump(0, u_south_ground_layers.x, uv);
			//nr0_out = texture_normal_roughness(0, u_south_ground_layers.x, uv);
		}
		if (u_south_ground_layers.y >= 0.0) {
			vec4 ab1_south = texture_albedo_bump(1, u_south_ground_layers.y, uv);
			ab1_out = mix(ab1_out, ab1_south, weight);
			vec4 nr1_south = texture_normal_roughness(1, u_south_ground_layers.y, uv);
			nr1_out = mix(nr1_out, nr1_south, weight);
			//ab1_out = texture_albedo_bump(1, u_south_ground_layers.y, uv);
			//nr1_out = texture_normal_roughness(1, u_south_ground_layers.y, uv);
		}
		if (u_south_ground_layers.z >= 0.0) {
			vec4 ab2_south = texture_albedo_bump(2, u_south_ground_layers.z, uv);
			ab2_out = mix(ab2_out, ab2_south, weight);
			vec4 nr2_south = texture_normal_roughness(2, u_south_ground_layers.z, uv);
			nr2_out = mix(nr2_out, nr2_south, weight);
			//ab2_out = texture_albedo_bump(2, u_south_ground_layers.z, uv);
			//nr2_out = texture_normal_roughness(2, u_south_ground_layers.z, uv);
		}
		if (u_south_ground_layers.a >= 0.0) {
			vec4 ab3_south = texture_albedo_bump(3, u_south_ground_layers.a, uv);
			ab3_out = mix(ab3_out, ab3_south, weight);
			vec4 nr3_south = texture_normal_roughness(3, u_south_ground_layers.a, uv);
			nr3_out = mix(nr3_out, nr3_south, weight);
			//ab3_out = texture_albedo_bump(3, u_south_ground_layers.a, uv);
			//nr3_out = texture_normal_roughness(3, u_south_ground_layers.a, uv);
		}
		//ab0_out = vec4(0.0, 1.0, 0.0, 1.0);
		//ab1_out = vec4(1.0, 0.0, 0.0, 1.0);
	}
	if (is_on_left_border(uv, distance_from_border)) {
		if (u_west_ground_layers.x >= 0.0) {
			vec4 ab0_west = texture_albedo_bump(0, u_west_ground_layers.x, uv);
			ab0_out = mix(ab0_out, ab0_west, weight);
			vec4 nr0_west = texture_normal_roughness(0, u_west_ground_layers.x, uv);
			nr0_out = mix(nr0_out, nr0_west, weight);
			//ab0_out = texture_albedo_bump(0, u_west_ground_layers.x, uv);
			//nr0_out = texture_normal_roughness(0, u_west_ground_layers.x, uv);
		}
		if (u_west_ground_layers.y >= 0.0) {
			vec4 ab1_west = texture_albedo_bump(1, u_west_ground_layers.y, uv);
			ab1_out = mix(ab1_out, ab1_west, weight);
			vec4 nr1_west = texture_normal_roughness(1, u_west_ground_layers.y, uv);
			nr1_out = mix(nr1_out, nr1_west, weight);
			//ab1_out = texture_albedo_bump(1, u_west_ground_layers.y, uv);
			//nr1_out = texture_normal_roughness(1, u_west_ground_layers.y, uv);
		}
		if (u_west_ground_layers.z >= 0.0) {
			vec4 ab2_west = texture_albedo_bump(2, u_west_ground_layers.z, uv);
			ab2_out = mix(ab2_out, ab2_west, weight);
			vec4 nr2_west = texture_normal_roughness(2, u_west_ground_layers.z, uv);
			nr2_out = mix(nr2_out, nr2_west, weight);
			//ab2_out = texture_albedo_bump(2, u_west_ground_layers.z, uv);
			//nr2_out = texture_normal_roughness(2, u_west_ground_layers.z, uv);
		}
		if (u_west_ground_layers.a >= 0.0) {
			vec4 ab3_west = texture_albedo_bump(3, u_west_ground_layers.a, uv);
			ab3_out = mix(ab3_out, ab3_west, weight);
			vec4 nr3_west = texture_normal_roughness(3, u_west_ground_layers.a, uv);
			nr3_out = mix(nr3_out, nr3_west, weight);
			//ab3_out = texture_albedo_bump(3, u_west_ground_layers.a, uv);
			//nr3_out = texture_normal_roughness(3, u_west_ground_layers.a, uv);
		}
		//ab0_out = vec4(0.0, 1.0, 0.0, 1.0);
		//ab1_out = vec4(1.0, 0.0, 0.0, 1.0);
	}
	if (is_on_right_border(uv, distance_from_border)) {
		if (u_east_ground_layers.x >= 0.0) {
			vec4 ab0_east = texture_albedo_bump(0, u_east_ground_layers.x, uv);
			ab0_out = mix(ab0_out, ab0_east, weight);
			vec4 nr0_east = texture_normal_roughness(0, u_east_ground_layers.x, uv);
			nr0_out = mix(nr0_out, nr0_east, weight);
			//ab0_out = texture_albedo_bump(0, u_east_ground_layers.x, uv);
			//nr0_out = texture_normal_roughness(0, u_east_ground_layers.x, uv);
		}
		if (u_east_ground_layers.y >= 0.0) {
			vec4 ab1_east = texture_albedo_bump(1, u_east_ground_layers.y, uv);
			ab1_out = mix(ab1_out, ab1_east, weight);
			vec4 nr1_east = texture_normal_roughness(1, u_east_ground_layers.y, uv);
			nr1_out = mix(nr1_out, nr1_east, weight);
			//ab1_out = texture_albedo_bump(1, u_east_ground_layers.y, uv);
			//nr1_out = texture_normal_roughness(1, u_east_ground_layers.y, uv);
		}
		if (u_east_ground_layers.z >= 0.0) {
			vec4 ab2_east = texture_albedo_bump(2, u_east_ground_layers.z, uv);
			ab2_out = mix(ab2_out, ab2_east, weight);
			vec4 nr2_east = texture_normal_roughness(2, u_east_ground_layers.z, uv);
			nr2_out = mix(nr2_out, nr2_east, weight);
			//ab2_out = texture_albedo_bump(2, u_east_ground_layers.z, uv);
			//nr2_out = texture_normal_roughness(2, u_east_ground_layers.z, uv);
		}
		if (u_east_ground_layers.a >= 0.0) {
			vec4 ab3_east = texture_albedo_bump(3, u_east_ground_layers.a, uv);
			ab3_out = mix(ab3_out, ab3_east, weight);
			vec4 nr3_east = texture_normal_roughness(3, u_east_ground_layers.a, uv);
			nr3_out = mix(nr3_out, nr3_east, weight);
			//ab3_out = texture_albedo_bump(3, u_east_ground_layers.a, uv);
			//nr3_out = texture_normal_roughness(3, u_east_ground_layers.a, uv);
		}
		//ab0_out = vec4(0.0, 1.0, 0.0, 1.0);
		//ab1_out = vec4(1.0, 0.0, 0.0, 1.0);
	}
}"

