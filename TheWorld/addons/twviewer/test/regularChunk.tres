nodes/fragment/89/position = Vector2(7100, -2280)
nodes/fragment/89/size = Vector2(1320, 2700)
nodes/fragment/89/input_ports = "0,4,albedo_in;1,0,roughness_in;2,4,normal_in;3,0,lod;4,0,quad_line_thickness;5,3,uv;6,6,grid_on;7,3,ground_uv0;"
nodes/fragment/89/output_ports = "0,4,albedo_out;1,0,roughness_out;2,4,normal_out;"
nodes/fragment/89/expression = "albedo_out = albedo_in;
normal_out = normal_in;
roughness_out = roughness_in;
if (lod >= 0.0) {
	//lod = floor(lod);
	float f = floor(lod);
	float c = ceil(lod);
	if ((lod - f) > (c - lod) ) {
		lod = c;
	} else {
		lod = f;
	}

	float chunk_border_line_thickness = 0.005;
	
	if (u_editmode_selected > 0.0 && is_on_the_border(UV, quad_line_thickness)) {
		albedo_out = vec3(1.0, 0.749, 0.0);		// GDN_TheWorld_Globals::g_color_yellow_apricot
	} else {
		if (u_mouse_hit != vec2(-1) && distance(u_mouse_hit, UV) < u_mouse_hit_radius) {
			albedo_out = vec3(1.0, 0.749, 0.0);		// GDN_TheWorld_Globals::g_color_yellow_apricot
		} else {
			if (is_on_the_border(UV, chunk_border_line_thickness) || is_on_the_border(UV2, chunk_border_line_thickness)) {
				//albedo_out = vec3(1.0, 1.0, 1.0);		// GDN_TheWorld_Globals::g_color_white
				albedo_out = vec3(0.0, 0.0, 0.0);		// GDN_TheWorld_Globals::g_color_black
			} else {
				if (lod >= 0.0 && lod <= 8.0) {
					albedo_out = lod_colors[int(lod)];
				} else {
					albedo_out = lod_colors[9];
				}
			}
		}
	}
}

//bool grid_on = !(mouse_hit == vec2(-1));
if (grid_on) {
	float half_texel_size = 0.5 / vec2(textureSize(u_terrain_heightmap, 0)).x;
	vec2 uv_begin_texel = uv - vec2(half_texel_size);
	vec2 distance_from_vertex = 
		fract(vec2(uv_begin_texel.x / (half_texel_size * 2.0), uv_begin_texel.y / (half_texel_size * 2.0)));
	if (distance_from_vertex.x < quad_line_thickness || (1.0 - distance_from_vertex.x) < quad_line_thickness
		|| distance_from_vertex.y < quad_line_thickness || (1.0 - distance_from_vertex.y) < quad_line_thickness) {
		if ((distance_from_vertex.x < quad_line_thickness || (1.0 - distance_from_vertex.x) < quad_line_thickness)
			&& (distance_from_vertex.y < quad_line_thickness || (1.0 - distance_from_vertex.y) < quad_line_thickness)) {
			//albedo_out = mix(albedo_out, vec3(1.0, 0.0, 0.0), 0.3);	// GDN_TheWorld_Globals::g_color_yellow_red
			albedo_out = vec3(1.0, 0.0, 0.0);	// GDN_TheWorld_Globals::g_color_yellow_red
		} else {
			//albedo_out = mix(albedo_out, vec3(1.0, 0.749, 0.0), 0.3);	// GDN_TheWorld_Globals::g_color_yellow_apricot
			albedo_out = vec3(1.0, 0.749, 0.0);	// GDN_TheWorld_Globals::g_color_yellow_apricot
		}
	}
	vec2 g_uv0 = fract(ground_uv0);
	float uv_line_thickness = quad_line_thickness / 10.0;
	if (g_uv0.x < uv_line_thickness || (1.0 - g_uv0.x) < uv_line_thickness
		|| g_uv0.y < uv_line_thickness || (1.0 - g_uv0.y) < uv_line_thickness) {
		albedo_out = mix(albedo_out, vec3(0.0, 0.0, 1.0), 0.3);		// GDN_TheWorld_Globals::g_color_blue;
	}
}

/*if (lod >= 0.0 && lod <= 511.0) {
	albedo_out = vec3(1.0);	// white
} else {
	albedo_out = vec3(0.0);	// black
}*/
/*if (UV2.x >= 0.0 && UV2.x <= 1.0 && UV2.y >= 0.0 && UV2.y <= 1.0) {
	albedo_out = vec3(1.0);	// white
}*/
//albedo_out = vec3(UV2.x, UV2.y, 1.0);"
