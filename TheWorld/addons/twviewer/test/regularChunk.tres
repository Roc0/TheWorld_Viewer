nodes/vertex/18/input_ports = "0,5,vertex_world_pos;1,4,camera_pos;"
nodes/vertex/18/output_ports = "0,0,distance_from_camera;1,0,distance_from_camera_on_terrain;2,0,close_mask;3,0,middle_mask;"
nodes/vertex/18/expression = "//vec3 camera_pos = INV_VIEW_MATRIX[3].xyz;
distance_from_camera = distance(vertex_world_pos.xyz, camera_pos);
distance_from_camera_on_terrain = distance(vertex_world_pos.xyz, vec3(camera_pos.x, camera_pos.y - gu_camera_altitude_from_terrain, camera_pos.z));
if (new) {
	close_mask = smoothstep(close_distance + close_blend_amount, close_distance, distance_from_camera);
	middle_mask = smoothstep(middle_distance + middle_blend_amount, middle_distance, distance_from_camera);
}"
nodes/vertex/19/node = SubResource("VisualShaderNodeVaryingSetter_8av8q")
