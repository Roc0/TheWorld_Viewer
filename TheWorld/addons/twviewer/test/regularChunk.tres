nodes/fragment/4/node = SubResource("VisualShaderNodeExpression_yk7c6")
nodes/fragment/4/position = Vector2(-1440, -480)
nodes/fragment/4/size = Vector2(1100, 1700)
nodes/fragment/4/input_ports = "0,0,distance_from_camera_on_terrain;1,4,vertex;2,5,ground_uv_scale_per_texture_in;3,2,piecing_threshold_factor;4,0,piece_size;5,0,scale_per_texture_factor;6,0,camera_altitude_from_terrain;"
nodes/fragment/4/output_ports = "0,5,ground_uv_scale_per_texture_out;1,1,pieces_from_camera_piece;"
nodes/fragment/4/expression = "//ground_uv_scale_per_texture_in = vec4(200.0, 200.0, 200.0, 200.0);
ground_uv_scale_per_texture_out = ground_uv_scale_per_texture_in;
pieces_from_camera_piece = -1;

int alt_piece = int(floor(camera_altitude_from_terrain / piece_size));
/*if (alt_piece < 4) {
	scale_per_texture_factor *= pow(2.0, float(alt_piece));
} else {
	camera_altitude_from_terrain = -1.0;
}*/
if (camera_altitude_from_terrain < altitude_uv_scale_threshold) {
	scale_per_texture_factor *= pow(2.0, float(alt_piece));
} else {
	camera_altitude_from_terrain = -1.0;
}

if (distance_from_camera_on_terrain < ground_uv_scale_threshold) {
	if (camera_altitude_from_terrain > 0.0) {
		vec3 fragment_world_pos = (INV_VIEW_MATRIX * vec4(vertex, 1.0)).xyz;
		int camera_piece_x = int(floor(CAMERA_POSITION_WORLD.x / piece_size));
		int camera_piece_z = int(floor(CAMERA_POSITION_WORLD.z / piece_size));
		int frag_piece_x = int(floor(fragment_world_pos.x / piece_size));
		int frag_piece_z = int(floor(fragment_world_pos.z / piece_size));
		pieces_from_camera_piece = max(int(abs(camera_piece_x - frag_piece_x)), int(abs(camera_piece_z - frag_piece_z)));
		if (pieces_from_camera_piece <= 1)
		{
			ground_uv_scale_per_texture_out /= (scale_per_texture_factor / 20.0);
			//ground_uv_scale_per_texture_out = vec4(40.0);
		}
		else if (pieces_from_camera_piece <= 3)
		{
			ground_uv_scale_per_texture_out /= (scale_per_texture_factor / 10.0);
			//ground_uv_scale_per_texture_out = vec4(20.0);
		}
		else if (pieces_from_camera_piece <= 5)
		{
			ground_uv_scale_per_texture_out /= (scale_per_texture_factor / 10.0);
			//ground_uv_scale_per_texture_out = vec4(20.0);
		}
		else if (pieces_from_camera_piece <= 7)
		{
			ground_uv_scale_per_texture_out /= (scale_per_texture_factor / 8.0);
			//ground_uv_scale_per_texture_out = vec4(16.0);
			//ground_uv_scale_per_texture_out = ground_uv_scale_per_texture_in;
		}
		else if (pieces_from_camera_piece <= 9)
		{
			ground_uv_scale_per_texture_out /= (scale_per_texture_factor / 4.0);
		}
		else if (pieces_from_camera_piece <= 11)
		{
			ground_uv_scale_per_texture_out /= (scale_per_texture_factor / 2.0);
			//ground_uv_scale_per_texture_out = vec4(6.0);
		}
	}
}
else
{
	float forced_scale_value_beyond_threshold = 1.0;
	ground_uv_scale_per_texture_out = vec4(forced_scale_value_beyond_threshold);
}
"
