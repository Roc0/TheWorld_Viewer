size = Vector2(1380, 1180)
expression = "vec3 base_ground_uv;

//ground_uv_scale_per_texture = vec4(2.0);
if (new) {
	ground_uv_scale_per_texture = vec4(1.0, 1.0, 1.0, 1.0);
}
base_ground_uv = vec3(uv.x, vertex_world_pos.y * MODEL_MATRIX[1][1], uv.y);
ground_uv0 = base_ground_uv.xz * ground_uv_scale_per_texture.x;
ground_uv1 = base_ground_uv.xz * ground_uv_scale_per_texture.y;
ground_uv2 = base_ground_uv.xz * ground_uv_scale_per_texture.z;
ground_uv3 = base_ground_uv * ground_uv_scale_per_texture.w;
"

