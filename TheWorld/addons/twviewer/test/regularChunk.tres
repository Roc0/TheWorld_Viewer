nodes/fragment/66/output_ports = "0,4,albedo_out;"
nodes/fragment/66/expression = "albedo_out = vec3(0.0, 0.0, 0.0);
if (uv.x >= 0.0 && uv.x <= 1.0) {
	albedo_out = vec3(1.0, 0.0, 0.0);
}
if (uv.y >= 0.0 && uv.y <= 1.0) {
	albedo_out = mix(albedo_out, vec3(0.0, 1.0, 0.0), vec3(0.5, 0.5, 0.5));
}"
