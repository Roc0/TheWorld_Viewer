						//n_out89p0 = vec3(1.0, 1.0, 1.0);		// GDN_TheWorld_Globals::g_color_white
						n_out89p0 = vec3(0.0, 0.0, 0.0);		// GDN_TheWorld_Globals::g_color_black
					} else {
						if (n_out88p0 >= 0.0 && n_out88p0 <= 8.0) {
							n_out89p0 = lod_colors[int(n_out88p0)];
						} else {
