// GlobalExpression:4
	/*bool is_on_the_border(vec2 uv, float distance_from_border) {
		if (uv.x > distance_from_border && uv.x < (1.0 - distance_from_border) && uv.y > distance_from_border && uv.y < (1.0 - distance_from_border)) {
