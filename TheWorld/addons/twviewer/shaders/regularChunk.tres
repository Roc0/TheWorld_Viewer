nodes/fragment/31/output_ports = "0,4,albedo_out;1,0,roughness_out;2,4,normal_out;"
nodes/fragment/31/expression = "if (mouse_hit != vec2(-1) && mouse_hit_radius != 0.0 && distance(mouse_hit, uv) < mouse_hit_radius) {
	vec3 mouse_hit_albedo = vec3(1.0, 0.749, 0.0);		// GDN_TheWorld_Globals::g_color_yellow_apricot
	albedo_out = mix(albedo_in, mouse_hit_albedo, 0.3);
	//albedo_out = vec3(1.0, 0.0, 0.0);
} else {
	albedo_out = albedo_in;
	//albedo_out = vec3(1.0, 0.0, 0.0);
}
//albedo_out = vec3(1.0, 0.0, 0.0);
normal_out = (VIEW_MATRIX * (vec4(normal_in, 0.0))).xyz;
roughness_out = roughness_in;"
nodes/fragment/33/node = SubResource("VisualShaderNodeExpression_halt2")
nodes/fragment/33/position = Vector2(-540, 1440)
nodes/fragment/33/size = Vector2(1000, 660)
nodes/fragment/33/input_ports = "0,0,distance_from_camera;1,0,globalmap_blend_start;2,0,globalmap_blend_distance;3,8,terrain_globalmap;4,3,uv;5,6,editmode_pixel;6,6,globalmap_pixel;"
nodes/fragment/33/output_ports = "0,4,albedo_out;1,0,roughness_out;2,0,globalmap_factor;"
nodes/fragment/33/expression = "globalmap_factor = 1.0;
roughness_out = 1.0;
if (editmode_pixel) {
	albedo_out = vec3(1.0, 0.749, 0.0);		// GDN_TheWorld_Globals::g_color_yellow_apricot
} else {
	albedo_out = texture(terrain_globalmap, uv).rgb;
	if (globalmap_pixel) {
		roughness_out = 0.5;
	} else {
		globalmap_factor = clamp((distance_from_camera - globalmap_blend_start) * globalmap_blend_distance, 0.0, 1.0);
		globalmap_factor *= globalmap_factor; // slower start, faster transition but far away
	}
}"
