	n_out56p1 = 0.0;
	n_out56p2 = vec3(0.0, 0.0, 0.0);
	{
		if (n_out25p0 || n_out25p1) {
			n_out56p1 = n_out30p1;
			n_out56p0 = n_out30p0;
			n_out56p2 = n_out30p2;
		} else {
			vec3 col0 = n_out30p3.rgb * n_out38p0;	// col(0-3) is the result of the pixel fetched from u_ground_albedo_bump_(0-3) modified by the value fetched from u_terrain_colormap and relative to the vertex corresponding to current pixel
			vec3 col1 = n_out30p4.rgb * n_out39p0;	// the value fetched from u_terrain_colormap if modified to the white according to the vector u_colormap_opacity_per_texture (default value don't modify the color)
			vec3 col2 = n_out30p5.rgb * n_out40p0;
			vec3 col3 = n_out30p6.rgb * n_out41p0;
			//col0 = n_out30p3.rgb;
			//col1 = n_out30p4.rgb;
			//col2 = n_out30p5.rgb;
			//col3 = n_out30p6.rgb;
		
			vec4 rough = vec4(n_out30p7.a, n_out30p8.a, n_out30p9.a, n_out30p10.a);
		
			//vec3 normal0 = unpack_normal(n_out30p7);
			//vec3 normal1 = unpack_normal(n_out30p8);
			//vec3 normal2 = unpack_normal(n_out30p9);
			//vec3 normal3 = unpack_normal(n_out30p10);
			vec3 normal0 = n_out30p7.rgb;
			vec3 normal1 = n_out30p8.rgb;
			vec3 normal2 = n_out30p9.rgb;
			vec3 normal3 = n_out30p10.rgb;
		
			vec4 w;
