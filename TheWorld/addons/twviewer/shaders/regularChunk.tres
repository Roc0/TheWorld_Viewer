[sub_resource type="VisualShaderNodeInput" id="VisualShaderNodeInput_sy0wq"]
input_name = "vertex"

[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_28flk"]
size = Vector2(620, 200)
expression = "// VERTEX coords are local to the chunk (as the material is applied to the mesh which is tied to the chunk) so they start from the beginning of the chunk: we need to trasform in world coord to abstract from chunk
vertex_world_pos = MODEL_MATRIX * vec4(vertex, 1);"

[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_51pd1"]
size = Vector2(1060, 540)
expression = "// to calculate coords of the vertex local to the quadrant we use affine inverse matrix of the global trasform of the quadtree
vec4 vertex_local_to_quadrant_pos = terrain_inverse_transform * vertex_world_pos;
// to get correct value from the textures (in the range 0 / max size in local coord) we need to consider the step 
// (dividing by it): in the textures heigths/normals are adjacent but in global/local coords are separated by the step
// vertex_cell_coords_in_textures ranges from 0 to heightmap size
vertex_cell_coords_in_textures = vertex_local_to_quadrant_pos.xz / vec2(grid_step * pow(2.0, float(optimization_level)));
// Moreover must add a half-offset so that we sample the center of pixels, otherwise bilinear filtering of the textures
// will give us mixed results (#183)
vertex_cell_coords_in_textures += vec2(0.5);
// Normalized UV to be in the range 0/1
uv = vertex_cell_coords_in_textures / vec2(textureSize(terrain_heightmap, 0));"

[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_64s2i"]
size = Vector2(920, 500)
expression = "vertex_with_h = vertex;
vertex_world_pos_with_h = vertex_world_pos;
float h = get_height(terrain_heightmap, u_terrain_height, uv);		// Height displacement from heigthmap
if (u_force_height_0) {													// Needed to bake globalmap
	vertex_with_h.y = 0.0;
	vertex_world_pos_with_h.y = 0.0;
} else {
	vertex_with_h.y = h;
	vertex_world_pos_with_h.y = h;
}"

