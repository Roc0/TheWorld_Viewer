expression = "vec3 base_ground_uv = vec3(vertex_cell_coords_in_textures.x, vertex_world_pos.y * MODEL_MATRIX[1][1], vertex_cell_coords_in_textures.y);
ground_uv0 = base_ground_uv.xz / ground_uv_scale_per_texture.x;		// 2-dimension vertex ccordinates in vertex textures (height, normal, splat, color, global) divided by a scale factor
