[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_cue6k"]
size = Vector2(620, 880)
expression = "north_border_pixel = false;
south_border_pixel = false;
west_border_pixel = false;
east_border_pixel = false;
splat_out = splat_in;

if (!editmode_pixel && !globalmap_pixel) {
	if (is_on_upper_border(uv, distance_from_border)) {
		north_border_pixel = true;
		//splat_out = splat_out + noise_color;
	}
	if (is_on_lower_border(uv, distance_from_border)) {
		south_border_pixel = true;
		//splat_out = splat_out + noise_color;
	}
	if (is_on_left_border(uv, distance_from_border)) {
		west_border_pixel = true;
		//splat_out = splat_out + noise_color;
	}
	if (is_on_right_border(uv, distance_from_border)) {
		east_border_pixel = true;
		//splat_out = splat_out + noise_color;
	}
}
//splat_out = splat_in;"

