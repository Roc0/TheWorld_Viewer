nodes/fragment/45/expression = "vec4 texture_albedo_bump_dismiss(int type, float layer, vec2 uv)
{
	if (layer < 0.0) {
		if (type == 0) {
			return texture(u_ground_albedo_bump_0, uv);
		} else if (type == 1) {
			return texture(u_ground_albedo_bump_1, uv);
		} else if (type == 2) {
			return texture(u_ground_albedo_bump_2, uv);
		} else {
			return texture(u_ground_albedo_bump_3, uv);
		}
	} else {
		return texture(gu_ground_albedo_bump_array, vec3(uv, layer));
	}
}

vec4 texture_normal_roughness_dismiss(int type, float layer, vec2 uv)
{
	if (layer < 0.0) {
