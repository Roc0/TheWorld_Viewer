			vec3 ground_normal = /*u_terrain_normal_basis **/ (
				w.r * normal0 +
				w.g * normal1 +
				w.b * normal2 +
				w.a * normal3) / w_sum;
			// If no n_out73p4 textures are defined, normal vectors will default to (1,1,1),
