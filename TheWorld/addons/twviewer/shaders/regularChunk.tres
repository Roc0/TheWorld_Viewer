	bool north_border_pixel, 
	bool south_border_pixel, 
	bool west_border_pixel, 
	bool east_border_pixel, 
	vec2 uv)
{
	if (type == 0) {
		if (north_border_pixel && u_north_ground_layers.x >= 0.0) {
