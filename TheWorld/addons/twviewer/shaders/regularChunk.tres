ground_uv2 = base_ground_uv.xz / ground_uv_scale_per_texture.z;
ground_uv3 = base_ground_uv / ground_uv_scale_per_texture.w;		// 3-dimension vertex ccordinates in vertex textures (height, normal, splat, color, global) divided by a scale factor (y coord is height in world coord)"
