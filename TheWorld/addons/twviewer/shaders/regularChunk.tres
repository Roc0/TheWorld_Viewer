			if (n_out36p0) {
				w = get_depth_blended_weights(n_out73p4, vec4(n_out30p3.a, n_out30p4.a, n_out30p5.a, n_out30p6.a));
			} else {
				w = n_out73p4.rgba;
			}
		
			float w_sum = (w.r + w.g + w.b + w.a);
		
			n_out56p0 = (
				w.r * col0.rgb +
				w.g * col1.rgb +
				w.b * col2.rgb +
				w.a * col3.rgb) / w_sum;
		
			n_out56p1 = (
				w.r * rough.r +
				w.g * rough.g +
				w.b * rough.b +
