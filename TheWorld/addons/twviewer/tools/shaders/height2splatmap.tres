[resource]
code = "shader_type canvas_item;
render_mode blend_disabled;

uniform sampler2D u_terrain_heightmap;
uniform float u_terrain_height = 1;
uniform sampler2D u_terrain_normalmap;
uniform float u_slope_vertical_factor = 4;
uniform float u_slope_flat_factor = 1;
uniform float u_dirt_on_rocks_factor = 2;
uniform float u_high_elevation_factor = 4;
uniform float u_low_elevation_factor = 2;
uniform float u_min_heigth;
uniform float u_max_heigth;
uniform sampler2D tex_frg_17;
global uniform float gu_splatmap_blending_size = 0.10000000149012;
uniform vec2 u_north_heights = vec2(200000.000000, -200000.000000);
uniform vec2 u_south_heights = vec2(200000.000000, -200000.000000);
uniform vec2 u_west_heights = vec2(200000.000000, -200000.000000);
uniform vec2 u_east_heights = vec2(200000.000000, -200000.000000);


// GlobalExpression:0
	#include \"res://addons/twviewer/shaders/include/CommonFunctions.gdshaderinc\"

void fragment() {
// Input:14
	vec2 n_out14p0 = UV;


// FloatParameter:11
	float n_out11p0 = u_terrain_height;


// FloatParameter:4
	float n_out4p0 = u_slope_vertical_factor;


// FloatParameter:5
	float n_out5p0 = u_slope_flat_factor;


// FloatParameter:6
	float n_out6p0 = u_dirt_on_rocks_factor;


// FloatParameter:7
	float n_out7p0 = u_high_elevation_factor;


// FloatParameter:8
	float n_out8p0 = u_low_elevation_factor;


// FloatParameter:9
	float n_out9p0 = u_min_heigth;


// FloatParameter:10
	float n_out10p0 = u_max_heigth;


// Texture2D:17
	vec4 n_out17p0 = texture(tex_frg_17, UV);


// FloatConstant:20
	float n_out20p0 = 0.000000;


// FloatParameter:30
	float n_out30p0 = gu_splatmap_blending_size;


	vec3 n_out21p0;
// If:21
	float n_in21p1 = 0.00000;
	float n_in21p2 = 0.00001;
	if(abs(n_out20p0 - n_in21p1) < n_in21p2)
	{
		n_out21p0 = vec3(n_out30p0);
	}
	else if(n_out20p0 < n_in21p1)
	{
		n_out21p0 = vec3(n_out20p0);
	}
	else
	{
		n_out21p0 = vec3(n_out20p0);
	}


// VectorOp:18
	vec3 n_out18p0 = vec3(n_out17p0.xyz) * n_out21p0;


	bool n_out19p0;
	bool n_out19p1;
	bool n_out19p2;
	bool n_out19p3;
// Expression:19
	n_out19p0 = false;
	n_out19p1 = false;
	n_out19p2 = false;
	n_out19p3 = false;
	{
		n_out19p0 = false;
		n_out19p1 = false;
		n_out19p2 = false;
		n_out19p3 = false;
		
		if (is_on_upper_border(n_out14p0, n_out18p0.x)) {
			n_out19p0 = true;
		}
		if (is_on_lower_border(n_out14p0, n_out18p0.x)) {
			n_out19p1 = true;
		}
		if (is_on_left_border(n_out14p0, n_out18p0.x)) {
			n_out19p2 = true;
		}
		if (is_on_right_border(n_out14p0, n_out18p0.x)) {
			n_out19p3 = true;
		}
		
	}


// Vector2Parameter:25
	vec2 n_out25p0 = u_north_heights;


// Vector2Parameter:26
	vec2 n_out26p0 = u_south_heights;


// Vector2Parameter:27
	vec2 n_out27p0 = u_west_heights;


// Vector2Parameter:28
	vec2 n_out28p0 = u_east_heights;


	vec4 n_out12p0;
// Expression:12
	n_out12p0 = vec4(0.0, 0.0, 0.0, 0.0);
	{
		//vec2 ps = TEXTURE_PIXEL_SIZE;
		//n_out14p0 += ps;
		float h = get_height(TEXTURE, u_terrain_height, n_out14p0);
		vec3 n = get_normal_1(u_terrain_normalmap, n_out14p0);
		//n = normalize(vec3(0.5, 0.5, 0.5));
		float slope = (n_out4p0 * (1.0 - n.y)) - u_slope_flat_factor;
		float rocks_amount = clamp(slope, 0.0, 1.0);
		float dirt_amount = clamp(rocks_amount * n_out6p0, 0.0, 1.0);
		float min_h = n_out9p0;
		float max_h = n_out10p0;
		if (n_out19p0) {
			min_h = min(min_h, n_out25p0.x);
			max_h = max(max_h, n_out25p0.y);
		}
		if (n_out19p1) {
			min_h = min(min_h, n_out26p0.x);
			max_h = max(max_h, n_out26p0.y);
		}
		if (n_out19p2) {
			min_h = min(min_h, n_out27p0.x);
			max_h = max(max_h, n_out27p0.y);
		}
		if (n_out19p3) {
			min_h = min(min_h, n_out28p0.x);
			max_h = max(max_h, n_out28p0.y);
		}
		float high_elevation_amount = n_out7p0 * ((h - min_h) / (max_h - min_h)) - n_out8p0;
		high_elevation_amount = clamp(high_elevation_amount, 0.0, 1.0);
		float low_elevation_amount = 1.0 - high_elevation_amount;
			
		vec4 n_out12p0;
		
		//if (!n_out19p0 && !n_out19p1 && !n_out19p2 && !n_out19p3)
		
		n_out12p0.r = low_elevation_amount;
		n_out12p0.r = lerp_f(n_out12p0.r, 0.0, high_elevation_amount);
		n_out12p0.r = lerp_f(n_out12p0.r, 0.0, dirt_amount);
		n_out12p0.r = lerp_f(n_out12p0.r, 0.0, rocks_amount);
		n_out12p0.g = high_elevation_amount;
		n_out12p0.g = lerp_f(n_out12p0.g, 0.0, dirt_amount);
		n_out12p0.g = lerp_f(n_out12p0.g, 0.0, rocks_amount);
		n_out12p0.b = dirt_amount;
		n_out12p0.b = lerp_f(n_out12p0.b, 0.0, rocks_amount);
		n_out12p0.a = rocks_amount;
		
		/*vec3 red = vec3(1.0, 0.0, 0.0);
		vec3 green = vec3(0.0, 1.0, 0.0);
		vec3 blue = vec3(0.0, 0.0, 1.0);
		vec3 yellow = vec3(1.0, 0.749, 0.0);
		if (n_out19p0) {
			n_out12p0 = vec4(red, 1.0);
		}
		else if (n_out19p1) {
			n_out12p0 = vec4(green, 1.0);
		}
		else if (n_out19p2) {
			n_out12p0 = vec4(blue, 1.0);
		}
		else if (n_out19p3) {
			n_out12p0 = vec4(yellow, 1.0);
		} else {
			n_out12p0 = vec4(0.0, 0.0, 0.0, 1.0);
		}*/
		
		COLOR = n_out12p0;
	}


// VectorDecompose:15
	float n_out15p0 = n_out12p0.x;
	float n_out15p1 = n_out12p0.y;
	float n_out15p2 = n_out12p0.z;
	float n_out15p3 = n_out12p0.w;


// VectorCompose:16
	vec3 n_out16p0 = vec3(n_out15p0, n_out15p1, n_out15p2);


// Output:0
	NORMAL = n_out16p0;


}
"
