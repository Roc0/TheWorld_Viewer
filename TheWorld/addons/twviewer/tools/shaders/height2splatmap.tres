[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_si6mi"]
size = Vector2(980, 2240)
expression = "//vec2 ps = TEXTURE_PIXEL_SIZE;
//uv += ps;
float h = get_height(tex, u_terrain_height, uv);
vec3 n = get_normal_1(terrain_normalmap, uv);
//n = normalize(vec3(0.5, 0.5, 0.5));
float slope = (slope_vertical_factor * (1.0 - n.y)) - u_slope_flat_factor;
float rocks_amount = clamp(slope, 0.0, 1.0);
float dirt_amount = clamp(rocks_amount * dirt_on_rocks_factor, 0.0, 1.0);
float min_h = min_heigth;
float max_h = max_heigth;
if (north_border_pixel) {
	min_h = min(min_h, north_heights.x);
	max_h = max(max_h, north_heights.y);
}
if (south_border_pixel) {
	min_h = min(min_h, south_heights.x);
	max_h = max(max_h, south_heights.y);
}
if (west_border_pixel) {
	min_h = min(min_h, west_heights.x);
	max_h = max(max_h, west_heights.y);
}
if (east_border_pixel) {
	min_h = min(min_h, east_heights.x);
	max_h = max(max_h, east_heights.y);
}
float high_elevation_amount = high_elevation_factor * ((h - min_h) / (max_h - min_h)) - low_elevation_factor;
high_elevation_amount = clamp(high_elevation_amount, 0.0, 1.0);
float low_elevation_amount = 1.0 - high_elevation_amount;
	
vec4 splat_pixel;

//if (!north_border_pixel && !south_border_pixel && !west_border_pixel && !east_border_pixel)

splat_pixel.r = low_elevation_amount;
splat_pixel.r = lerp_f(splat_pixel.r, 0.0, high_elevation_amount);
splat_pixel.r = lerp_f(splat_pixel.r, 0.0, dirt_amount);
splat_pixel.r = lerp_f(splat_pixel.r, 0.0, rocks_amount);
splat_pixel.g = high_elevation_amount;
splat_pixel.g = lerp_f(splat_pixel.g, 0.0, dirt_amount);
splat_pixel.g = lerp_f(splat_pixel.g, 0.0, rocks_amount);
splat_pixel.b = dirt_amount;
splat_pixel.b = lerp_f(splat_pixel.b, 0.0, rocks_amount);
splat_pixel.a = rocks_amount;

/*vec3 red = vec3(1.0, 0.0, 0.0);
vec3 green = vec3(0.0, 1.0, 0.0);
vec3 blue = vec3(0.0, 0.0, 1.0);
vec3 yellow = vec3(1.0, 0.749, 0.0);
if (north_border_pixel) {
	splat_pixel = vec4(red, 1.0);
}
else if (south_border_pixel) {
	splat_pixel = vec4(green, 1.0);
}
else if (west_border_pixel) {
	splat_pixel = vec4(blue, 1.0);
}
else if (east_border_pixel) {
	splat_pixel = vec4(yellow, 1.0);
} else {
	splat_pixel = vec4(0.0, 0.0, 0.0, 1.0);
}*/

COLOR = splat_pixel;"

