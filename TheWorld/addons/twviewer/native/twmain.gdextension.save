[configuration]

entry_symbol = "tw_main_library_init"
compatibility_minimum = 4.3

[libraries]

#macos.debug = "res://bin/libgdexample.macos.template_debug.framework"
#macos.release = "res://bin/libgdexample.macos.template_release.framework"
#windows.debug.x86_32 = "res://bin/libgdexample.windows.template_debug.x86_32.dll"
#windows.release.x86_32 = "res://bin/libgdexample.windows.template_release.x86_32.dll"

# editor and template_debug
#windows.editor.x86_64 = "res://addons/twviewer/native/TheWorld_GDN_Viewer_d.dll"
windows.debug.x86_64 = "res://addons/twviewer/native/TheWorld_GDN_Viewer_d.dll"
#windows.debug.x86_64 = "res://addons/twviewer/native/TheWorld_GDN_Viewer.dll"

# template_release
#windows.release.x86_64 = "res://addons/twviewer/native/TheWorld_GDN_Viewer.dll"
windows.x86_64 = "res://addons/twviewer/native/TheWorld_GDN_Viewer.dll"
#windows.x86_64 = "res://Export/TheWorld_GDN_Viewer.dll"

#linux.debug.x86_64 = "res://bin/libgdexample.linux.template_debug.x86_64.so"
#linux.release.x86_64 = "res://bin/libgdexample.linux.template_release.x86_64.so"
#linux.debug.arm64 = "res://bin/libgdexample.linux.template_debug.arm64.so"
#linux.release.arm64 = "res://bin/libgdexample.linux.template_release.arm64.so"
#linux.debug.rv64 = "res://bin/libgdexample.linux.template_debug.rv64.so"
#linux.release.rv64 = "res://bin/libgdexample.linux.template_release.rv64.so"
#android.debug.x86_64 = "res://bin/libgdexample.android.template_debug.x86_64.so"
#android.release.x86_64 = "res://bin/libgdexample.android.template_release.x86_64.so"
#android.debug.arm64 = "res://bin/libgdexample.android.template_debug.arm64.so"
#android.release.arm64 = "res://bin/libgdexample.android.template_release.arm64.so"

[icons]

GDN_TheWorld_Globals = "res://addons/twviever/icons/Node.svg"
GDN_TW_Globals = "res://addons/twviever/icons/Node.svg"
GDN_TheWorld_Viewer = "res://addons/twviever/icons/Node3D.svg"
GDN_TW_Viewer = "res://addons/twviever/icons/Node3D.svg"
GDN_TheWorld_Camera = "res://addons/twviever/icons/Camera3D.svg"
GDN_TW_Camera = "res://addons/twviever/icons/Camera3D.svg"
GDN_TheWorld_Main = "res://addons/twviever/icons/Node.svg"
GDN_TW_Main = "res://addons/twviever/icons/Node.svg"
GDN_TheWorld_MapViewer = "res://addons/twviever/icons/Node2D.svg"
GDN_TW_MapViewer = "res://addons/twviever/icons/Node2D.svg"
GDN_TheWorld_MapCamera = "res://addons/twviever/icons/Camera2D.svg"

[dependencies]

#macos.debug = {"res://bin/libdependency.macos.template_debug.framework" : "Contents/Frameworks"}
#macos.release = {"res://bin/libdependency.macos.template_release.framework" : "Contents/Frameworks"}
windows.debug = {
    "res://addons/twviewer/native/TheWorld_MapManager_d.dll" : "",
    "res://addons/twviewer/native/TheWorld_Utils_d.dll" : "",
    "res://addons/twviewer/native/TheWorld_MapManager.json" : "",
	"res://addons/twviewer/native/Export/TheWorld_GDN_Viewer.json" : ""
}
windows.release = {
    "res://addons/twviewer/native/TheWorld_MapManager.dll" : "",
    "res://addons/twviewer/native/TheWorld_Utils.dll" : "",
    "res://addons/twviewer/native/TheWorld_MapManager.json" : "",
	"res://addons/twviewer/native/Export/TheWorld_GDN_Viewer.json" : ""
}
